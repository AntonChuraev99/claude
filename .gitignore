# ============================================================================
#  WHITELIST .gitignore
#
#  Strategy: ignore EVERYTHING by default, then re-include ONLY the files
#  meant for publication. This makes leaks structurally impossible — secrets
#  (.credentials.json, real settings.json, projects/, history.jsonl, logs,
#  agent-memory, stats, plugins) are never tracked because they are simply
#  not on the allow-list below.
#
#  When adding a new file to the repo you MUST add an explicit `!` rule here,
#  otherwise git will not see it. That friction is intentional.
# ============================================================================

# --- 1. Ignore everything ---------------------------------------------------
*

# --- 2. Repo meta -----------------------------------------------------------
!/.gitignore
!/.gitattributes
!/README.md
!/LICENSE
!/CLAUDE.md
!/settings.example.json

# --- 3. Hook & status-line scripts (referenced from settings.example.json) --
!/notify.ps1
!/statusline.py
!/statusline.sh
!/statusline-adb.sh
!/graphify-pretool.ps1
!/doc-writer-update-reminder.ps1
!/toast-action.ps1
!/toast-action-launcher.vbs

# --- 3a. Shared library for the status line and the hooks -------------------
#  Not optional: statusline.py and hooks/session-docs-digest.py import from
#  here, so a clone without lib/ starts with a broken status line and silent
#  hooks.
!/lib/
!/lib/**
lib/__pycache__/

# --- 4. Subagents -----------------------------------------------------------
!/agents/
!/agents/**

# --- 5. Slash commands ------------------------------------------------------
!/commands/
!/commands/**

# --- 6. Output style --------------------------------------------------------

# --- 7. Reference docs ------------------------------------------------------
!/references/
!/references/**

# --- Anti-leak hook TEMPLATE (the live hook in .git/hooks/ is never tracked) -
!/hooks/
!/hooks/**

# --- 7a. Bug-pattern review system (rule registry + L1 runner + hook) --------
!/review-rules/
!/review-rules/**

# --- 7b. Per-model behavioral overlays (injected by hooks/model-overlay.ps1) -
!/model-overlays/
!/model-overlays/**

# --- 7c. Path-scoped rules (auto-loaded when Claude touches matching files) ---
!/rules/
!/rules/**

# --- 7d. Backlog for this repo (deliberately deferred config/agent work) -----
!/docs/
!/docs/backlog/
!/docs/backlog/**
!/docs/decisions/
!/docs/decisions/**

# --- 7d2. Improvements log — только записи, писавшиеся под публикацию --------
#  Журнал гипотез по правкам харнесса. Публикуется, чтобы улучшение ехало в MR
#  вместе с правкой, которую оно объясняет. Публична только та часть, что
#  писалась УЖЕ с расчётом на публикацию: 195 записей эпохи приватного каталога
#  лежат в archive/ и остаются приватными — половина называет реальные проекты,
#  ID аналитики и личные пути, то есть ровно то, что anti-leak хук блокирует.
#  Граница — происхождение записи, а не её дата: запись, написанная до перехода,
#  остаётся приватной, даже если датирована днём перехода.
#  Новая запись пишется санитизированной с первой строки (CLAUDE.md →
#  «Публичный репозиторий»), иначе pre-commit её не пропустит.
#  Правило покрывает только `*.md` в КОРНЕ: подкаталог или ассет (диаграмма,
#  дамп) остаётся невидимым, пока ему не добавят свою `!`-строку.
!/improvements/
!/improvements/*.md
/improvements/archive/

# --- 7e. Operator scripts run by hand (diagnostics, not wired to any event) --
#  Only the scripts themselves, by extension — NOT `**`. This is the folder a
#  one-off dump or a *.local.* helper naturally lands in, and a blanket rule
#  would publish it. Adding a new script here is meant to cost one line.
!/scripts/
!/scripts/*.ps1
!/scripts/*.py
!/scripts/*.sh
#  ...но `*.local.*` не публикуется ни в одном из расширений: это имя, под
#  которым сюда садится разовый дамп или помощник с приватными путями.
/scripts/*.local.*

# --- 8. Toast icons (used by notify.ps1) ------------------------------------
!/assets/
!/assets/events/
!/assets/events/*.png

# --- 9. Config templates: only *.example.* (never *.local.*) -----------------
!/config/
!/config/*.example.md
!/config/*.example.json
# Shared pattern list for credentials-guard.ps1 + its node prefilter: word
# lists only, no accounts or project ids, and both hooks are useless apart.
!/config/credentials-guard-patterns.json
!/config/optional-capabilities.md

# --- 11. Authored skills (each whitelisted; installed/3rd-party stay ignored)-
!/skills/
!/skills/ab-test-dashboard/
!/skills/ab-test-dashboard/**
!/skills/amplitude-slack-payload/
!/skills/amplitude-slack-payload/**
!/skills/cloudflare-deploy-slack-notify/
!/skills/cloudflare-deploy-slack-notify/**
!/skills/commit/
!/skills/commit/**
!/skills/task-gate/
!/skills/task-gate/**
!/skills/git-commit-conventions/
!/skills/git-commit-conventions/**
!/skills/git-worktree-env/
!/skills/git-worktree-env/**
!/skills/gitlab-release-slack-ci/
!/skills/gitlab-release-slack-ci/**
!/skills/gradle-deps-update/
!/skills/gradle-deps-update/**
!/skills/jira-task-writer/
!/skills/jira-task-writer/**
!/skills/stop-slop-ru/
!/skills/stop-slop-ru/**
!/skills/test-firebase-function/
!/skills/test-firebase-function/**
!/skills/turnstile-spin/
!/skills/turnstile-spin/**
!/skills/android-core-module-builder/
!/skills/android-core-module-builder/**
!/skills/android-feature-module-builder/
!/skills/android-feature-module-builder/**
!/skills/screenshot-driven-ui/
!/skills/screenshot-driven-ui/**
!/skills/device-mirror/
!/skills/device-mirror/**

# --- 11a. Process skills (kept after the 2026-08-03 revision) ----------------
!/skills/claude-profiles/
!/skills/claude-profiles/**
!/skills/subagent-authoring/
!/skills/subagent-authoring/**
!/skills/instruction-routing/
!/skills/instruction-routing/**
!/skills/workflow-orchestration/
!/skills/workflow-orchestration/**

# --- 12. Re-exclude junk inside otherwise-allowed skills ---------------------
/skills/jira-task-writer/evals/
/review-rules/__pycache__/

# --- 13. Belt-and-suspenders: hard-deny known sensitive files ----------------
#  (already ignored by `*`, repeated here so a careless `!` rule above can
#   never accidentally expose them)
.credentials.json
.claude.json
settings.json
settings.local.json
config/*.local.md
config/*.local.json
*.log
*.jsonl
#  Приватный архив улучшений: крупнейшее скопление приватного в дереве, и его
#  публичность держится одной `!`-строкой в 7d2. Дублируется здесь, чтобы
#  будущее `!/improvements/**` (естественная правка, когда захотят подкаталог)
#  не вскрыло архив последним совпадением.
/improvements/archive/
/improvements/archive/**

# --- 14. Work-in-progress, not for publication ------------------------------
/layout-debug-mcp/
